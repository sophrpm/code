fn fibonacci(n: i32) -> i32 {
    if n < 2 { return n; }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn main() {
    println!("OxigenNative en ARM64");
    println!("Fibonacci(10): {}", fibonacci(10));
    let mut matriz: [[i32; 3]; 2] = [[1, 2, 3], [4, 5, 6]];
    matriz[1][2] = 7;
    println!("Matriz: {:?}", matriz);
    let parte = &matriz[1][0..2];
    println!("Slice: {:?}", parte);
    let saludo = String::from("Hola Mundo");
    println!("{}", saludo.replace("Mundo", "ARM64"));
    println!("Palabras: {:?}", saludo.split(" "));
    let decimal: f64 = 7;
    println!("División: {}", decimal / 2);
}
